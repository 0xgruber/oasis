<clickhouse>
    <logger>
        <level>information</level>
        <log>/var/log/clickhouse-server/clickhouse-server.log</log>
        <errorlog>/var/log/clickhouse-server/clickhouse-server.err.log</errorlog>
        <size>1000M</size>
        <count>10</count>
    </logger>

    <!-- Memory settings for 32GB development environment -->
    <max_server_memory_usage>12G</max_server_memory_usage>
    <max_server_memory_usage_to_ram_ratio>0.9</max_server_memory_usage_to_ram_ratio>
    
    <!-- Query memory limits -->
    <max_memory_usage>8G</max_memory_usage>
    
    <!-- Connection settings -->
    <max_connections>1024</max_connections>
    <max_concurrent_queries>100</max_concurrent_queries>
    
    <!-- Performance settings -->
    <mark_cache_size>5G</mark_cache_size>
    <max_threads>8</max_threads>
    
    <!-- Network settings -->
    <listen_host>0.0.0.0</listen_host>
    
    <!-- HTTP interface -->
    <http_port>8123</http_port>
    
    <!-- Native TCP -->
    <tcp_port>9000</tcp_port>
    
    <!-- Compression -->
    <compression>
        <case>
            <method>lz4</method>
        </case>
    </compression>
</clickhouse>
