#############################################################################
# O.A.S.I.S. Environment Configuration
# Copy this file to .env and update with your values
#############################################################################

#############################################################################
# PostgreSQL Configuration
#############################################################################
POSTGRES_DB=oasis
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=changeme-use-strong-password

# Service-specific PostgreSQL users (created by init scripts)
POSTGRES_GATEWAY_USER=gateway_user
POSTGRES_GATEWAY_PASSWORD=changeme-gateway-password
POSTGRES_INGESTION_USER=ingestion_user
POSTGRES_INGESTION_PASSWORD=changeme-ingestion-password
POSTGRES_API_USER=api_user
POSTGRES_API_PASSWORD=changeme-api-password

#############################################################################
# ClickHouse Configuration
#############################################################################
CLICKHOUSE_DB=oasis
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=changeme-use-strong-password

# Service-specific ClickHouse users (created by init scripts)
CLICKHOUSE_INGESTION_USER=ingestion_user
CLICKHOUSE_INGESTION_PASSWORD=changeme-ingestion-password
CLICKHOUSE_API_USER=api_user
CLICKHOUSE_API_PASSWORD=changeme-api-password

#############################################################################
# JWT Authentication
#############################################################################
# IMPORTANT: Generate a secure secret with: openssl rand -hex 32
JWT_SECRET=changeme-generate-secure-secret-with-openssl
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

#############################################################################
# TOTP (Two-Factor Authentication)
#############################################################################
TOTP_ISSUER=O.A.S.I.S.

#############################################################################
# Ingestion Configuration
#############################################################################
BATCH_SIZE=1000
BATCH_TIMEOUT_SECONDS=5

#############################################################################
# Logging
#############################################################################
LOG_LEVEL=INFO

#############################################################################
# Development Settings
#############################################################################
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
